# Skopiuj do .env i dostosuj. Żadnych kluczy ani haseł nie trzymamy w kodzie.
# API dane.gov.pl nie wymaga klucza.

# Katalog na pobrane i przetworzone dane
DATA_DIR=data
# Port serwera HTTP
PORT=8000
# API i identyfikator zbioru "Rejestr Aptek" na dane.gov.pl
DANE_GOV_API=https://api.dane.gov.pl/1.4
DANE_GOV_DATASET_ID=1925
# Opcjonalnie: bezpośredni adres pliku CSV (pomija wyszukiwanie zasobu w API)
CSV_URL=
# Strefa czasowa używana do filtra "otwarta teraz"
TZ_NAME=Europe/Warsaw
